# Environment Variables Configuration
# Copy this file to .env and update with your actual values
# For production, ensure all passwords are strong and secure

# Database Configuration
DB_HOST=mysql-db
DB_PORT=3306
DB_NAME=student_shuttles_db
DB_USER=shuttles_user
DB_PASSWORD=your_secure_password_here
DB_USERNAME=shuttles_user

# Server Configuration
SERVER_PORT=8080
SERVER_SSL_ENABLED=false
SERVER_SSL_KEY_STORE=/app/certs/keystore.p12
SERVER_SSL_KEY_STORE_PASSWORD=your_strong_keystore_password_here
SERVER_SSL_KEY_STORE_TYPE=PKCS12

# Spring Profiles
SPRING_PROFILES_ACTIVE=dev

# Java Runtime Options
JAVA_OPTS=-Xmx512m -Xms256m

# Logging Configuration
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APPLICATION=DEBUG
LOGGING_FILE=logs/student-shuttles.log
LOGGING_FILE_MAX_SIZE=10MB
LOGGING_FILE_MAX_HISTORY=10

# Database Connection Pool (HikariCP)
DB_POOL_SIZE=20
DB_MIN_IDLE=5
DB_IDLE_TIMEOUT=300000
DB_MAX_LIFETIME=1800000
DB_CONNECTION_TIMEOUT=20000

# Application Settings
APP_NAME=StudentShuttles
APP_VERSION=1.0.0
APP_ENVIRONMENT=development

# Security
SECURITY_JWT_SECRET=your_jwt_secret_here_at_least_32_chars
SECURITY_JWT_EXPIRATION=86400000

# Actuator
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,metrics,info
